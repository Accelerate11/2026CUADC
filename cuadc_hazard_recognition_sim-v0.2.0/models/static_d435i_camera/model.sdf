<?xml version="1.0"?>
<sdf version="1.9">
  <model name="static_d435i_camera">
    <static>true</static>
    <link name="camera_link">
      <visual name="body">
        <geometry><box><size>0.18 0.04 0.04</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="hazard_d435i_rgbd" type="rgbd_camera">
        <pose>0 0 0 0 1.57079632679 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/hazard_d435i</topic>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>1536</width>
            <height>1536</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
