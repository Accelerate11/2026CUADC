<?xml version="1.0"?>
<package format="3">
  <name>cuadc_bringup</name>
  <version>4.0.1</version>
  <description>CUADC launch, mission configuration and route heading loader.</description>
  <maintainer email="flight-team@example.invalid">CUADC Flight Team</maintainer>
  <license>AGPL-3.0-only</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>cuadc_mission</exec_depend>
  <exec_depend>cuadc_perception</exec_depend>
  <exec_depend>cuadc_tools</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
